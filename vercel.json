{
  "cleanUrls": true,
  "trailingSlash": false,
  "buildCommand": "node gen-index.mjs",
  "outputDirectory": ".",
  "headers": [
    {
      "source": "/funnel/tracker/:path*",
      "headers": [
        {"key": "Cross-Origin-Opener-Policy", "value": "same-origin-allow-popups"},
        {"key": "Referrer-Policy", "value": "strict-origin-when-cross-origin"},
        {"key": "X-Robots-Tag", "value": "noindex, nofollow"}
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/ios-results",
      "destination": "/funnel/general/results-50"
    }
  ],
  "redirects": [
    {
      "source": "/inapp/stats-v17b",
      "destination": "/inapp/progress",
      "permanent": true
    },
    {
      "source": "/inapp/stats-v17b.html",
      "destination": "/inapp/progress",
      "permanent": true
    }
  ]
}
