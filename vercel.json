{
  "cleanUrls": true,
  "trailingSlash": false,
  "buildCommand": "node gen-index.mjs",
  "outputDirectory": ".",
  "functions": {
    "api/funnel-review.js": {"includeFiles": "node_modules/@sparticuz/chromium/bin/**", "maxDuration": 60},
    "api/funnel-production.js": {"includeFiles": "node_modules/@sparticuz/chromium/bin/**", "maxDuration": 60},
    "api/funnel-production-cron.js": {"includeFiles": "node_modules/@sparticuz/chromium/bin/**", "maxDuration": 800}
  },
  "crons": [{"path": "/api/funnel-production-cron", "schedule": "*/15 * * * *"}],
  "headers": [
    {
      "source": "/funnel/tracker/:path*",
      "headers": [
        {"key": "Cross-Origin-Opener-Policy", "value": "same-origin-allow-popups"},
        {"key": "Referrer-Policy", "value": "strict-origin-when-cross-origin"},
        {"key": "X-Robots-Tag", "value": "noindex, nofollow"}
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/funnel/working/:pageKey",
      "destination": "/api/funnel-review?action=draft-html&pageKey=:pageKey"
    },
    {
      "source": "/ios-results",
      "destination": "/funnel/general/results-50"
    }
  ],
  "redirects": [
    {
      "source": "/inapp/stats-v17b",
      "destination": "/inapp/progress",
      "permanent": true
    },
    {
      "source": "/inapp/stats-v17b.html",
      "destination": "/inapp/progress",
      "permanent": true
    }
  ]
}
